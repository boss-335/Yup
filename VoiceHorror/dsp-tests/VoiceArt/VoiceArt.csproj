<Project Sdk="Microsoft.NET.Sdk">
  <!-- Same sources Unity compiles in Assets/VoiceArt (noEngineReferences), at Unity's C# level. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>VoiceArt</AssemblyName>
    <RootNamespace>VoiceHorror.Art</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/VoiceArt/**/*.cs" />
  </ItemGroup>
</Project>
