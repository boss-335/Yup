<Project Sdk="Microsoft.NET.Sdk">
  <!-- Online play (GDD §7.1): message protocol, authoritative game server (rooms, matchmaking, battle),
       TCP transport and client. Depends on BattleRules.Core only: clients analyse their own voice
       (VoiceMatch) and send results; the server never needs audio. netstandard2.1 so Unity can use it. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>VoiceBattle.Net</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BattleRules.Core\BattleRules.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VoiceBattle.Net.Tests" />
  </ItemGroup>
</Project>
