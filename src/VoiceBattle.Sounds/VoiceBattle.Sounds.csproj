<Project Sdk="Microsoft.NET.Sdk">
  <!-- User sounds (GDD §5.4): upload checks, library, moderation, takedown. Usable by the game client
       and by a future server; depends on VoiceMatch.Core only (no Unity, no battle rules). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>VoiceBattle.Sounds</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VoiceMatch.Core\VoiceMatch.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VoiceBattle.Sounds.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NLayer" Version="1.16.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>
</Project>
