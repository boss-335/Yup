<Project Sdk="Microsoft.NET.Sdk">
  <!-- netstandard2.1 so the same DLL can be dropped into Unity later (GDD §0.2-0.3). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>VoiceMatch.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VoiceMatch.Core.Tests" />
  </ItemGroup>
</Project>
